---
import { siteConfig } from '../config';
const url = siteConfig.mapEmbedUrl;
---
<div class="card map-embed" style="margin: 18px 0">
  <iframe
    width="100%"
    height="380"
    style="border:0; border-radius: 12px;"
    src={url}
    title="Live map of the server world"
    loading="lazy"
    referrerpolicy="no-referrer"
  ></iframe>
  <p class="lede" style="margin: 10px 0 0; font-size: 0.85rem;">
    This is the real server world, rendered live by BlueMap. If it's blank,
    the map may be offline —{' '}
    <a href={url} target="_blank" rel="noopener noreferrer">open it directly</a>.
  </p>
</div>