---
import { siteConfig } from '../config';

const url = siteConfig.livePlayersUrl;
const refresh = siteConfig.updateIntervalMs;
const mapLink = siteConfig.mapEmbedUrl;
---

<div class="card players" id="server-status">
  <h3 id="status-title">Server status</h3>
  <span class="status" id="status-line">
    <span class="dot unknown" id="status-dot"></span>
    <span id="status-text">Checking…</span>
  </span>
  <ul id="player-list"></ul>
  <p class="lede" style="margin: 10px 0 0; font-size: 0.85rem;">
    Status comes from the live map feed, not the game connection. Live view of
    the world:{' '}
    <a href={mapLink} target="_blank" rel="noopener noreferrer">open full map</a>
  </p>
</div>

<script define:vars={{ url, refresh }}>
  const dot = document.querySelector('#status-dot');
  const text = document.querySelector('#status-text');
  const list = document.querySelector('#player-list');
  const TIMEOUT_MS = 8000;
  let controller;

  function setUnreachable() {
    dot.className = 'dot';
    text.textContent = "Can't reach the live feed at the moment";
    list.replaceChildren();
  }

  async function refreshNow() {
    controller?.abort();
    controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), TIMEOUT_MS);
    try {
      const res = await fetch(url, { signal: controller.signal });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      const raw = (data.players ?? []) as Array<{ name?: string }>;
      const online = raw
        .filter((p) => typeof p?.name === 'string')
        .map((p) => (p as { name: string }).name)
        .sort();

      dot.className = 'dot ok';
      text.textContent = online.length
        ? `Online · ${online.length} player${online.length === 1 ? '' : 's'} online`
        : 'Online · no one online at the moment';

      list.replaceChildren();
      for (const name of online) {
        const li = document.createElement('li');
        li.textContent = name;
        list.appendChild(li);
      }
    } catch {
      setUnreachable();
    } finally {
      clearTimeout(timer);
    }
  }

  refreshNow();
  setInterval(refreshNow, refresh);
</script>