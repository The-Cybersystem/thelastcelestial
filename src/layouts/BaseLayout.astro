---
import { siteConfig } from '../config';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  frontmatter?: { title?: string; description?: string };
}

const { title, description, frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL;
const finalTitle = title ?? frontmatter?.title;
const pageTitle = finalTitle ? `${finalTitle} · ${siteConfig.name}` : siteConfig.name;
const pageDesc = description ?? frontmatter?.description ?? siteConfig.tagline;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://the-cybersystem.github.io').toString();

const links: { href: string; label: string }[] = [
  { href: `${base}`, label: 'Home' },
  { href: `${base}docs/getting-started/`, label: 'Getting Started' },
  { href: `${base}docs/rules/`, label: 'Rules' },
  { href: `${base}lore/`, label: 'Lore' },
  { href: `${base}mods/`, label: 'Mods' },
  { href: `${base}archive/`, label: 'Archive' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDesc} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/png" href={`${base}tlc-favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap row">
        <div class="brand">
          <span class="mark" aria-hidden="true">✦</span>
          <a class="brand-name" href={base}>{siteConfig.name}</a>
        </div>
        <nav class="main" aria-label="Primary">
          {links.map((l) => (
            <a href={l.href}>{l.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p style="margin: 0">
          © 2026{' '}
          <a href="https://github.com/The-Cybersystem">The-Cybersystem</a> ·
          join at <code>exploringfoundation.ddns.net:25564</code> ·{' '}
          <a href={siteConfig.discordInvite} target="_blank" rel="noopener noreferrer">Discord</a>
        </p>
        <p class="footer-meta" style="margin: 6px 0 0; font-size: .85rem; opacity: .7;">
          <a style="color: inherit" href={`${base}privacy/`}>Privacy</a> ·{' '}
          <a style="color: inherit" href={`${base}terms/`}>Terms</a> ·{' '}
          <a style="color: inherit" href={`${base}docs/rules/`}>Rules</a>
        </p>
      </div>
    </footer>
  </body>
</html>