---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServerStatus from '../components/ServerStatus.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { siteConfig } from '../config';
import pack from '../data/version.json';
import modlist from '../data/modlist.json';

const base = import.meta.env.BASE_URL;
const cards = [
  {
    title: 'Getting Started',
    body: 'How to apply, install the modpack, and get in the world.',
    href: `${base}docs/getting-started/`,
    cta: 'Start here',
  },
  {
    title: 'The Rules',
    body: 'What keeps a small, hard-difficulty SMP friendly.',
    href: `${base}docs/rules/`,
    cta: 'Read the rules',
  },
  {
    title: 'The Lore',
    body: 'Realms, characters, factions, and the history so far.',
    href: `${base}lore/`,
    cta: 'Enter the lore',
  },
  {
    title: 'The Modpack',
    body: `${modlist.count} mods on Minecraft ${pack.minecraft}, kept in check.`,
    href: `${base}mods/`,
    cta: 'See the mods',
  },
];
const stats = [
  { label: 'Pack', value: pack.packVersion },
  { label: 'Mods', value: String(modlist.count) },
  { label: 'Loader', value: pack.loader },
  { label: 'Minecraft', value: pack.minecraft },
];
---

<BaseLayout
  title="A hard-mode Minecraft world, built by its own people"
  description={siteConfig.tagline}
>
  <section class="hero">
    <h1>The Last Celestial</h1>
    <p class="tagline">{siteConfig.tagline}</p>
    <p lang="en">
      A small, hard-mode, tightly-lore'd Minecraft community. Join at:
    </p>
    <div class="join">
      <code class="mc-address">{siteConfig.mcAddressDisplay}</code>
      <button id="copy-address" type="button">Copy</button>
      {siteConfig.discordInvite && <a class="discord-cta" href={siteConfig.discordInvite}>Join the Discord →</a>}
    </div>
    <div class="pills">
      {stats.map((s) => (
        <span class="pill">{s.label} {s.value}</span>
      ))}
      <span class="pill">Survival · Hard</span>
    </div>
  </section>

  <section class="grid">
    {cards.map((c) => (
      <div class="card">
        <h3>{c.title}</h3>
        <p>{c.body}</p>
        <a href={c.href}>{c.cta} →</a>
      </div>
    ))}
  </section>

  <section class="grid" style="grid-template-columns: 1fr">
    <ServerStatus />
  </section>

  <section class="grid" style="grid-template-columns: 1fr; margin-top: 16px">
    <MapEmbed />
  </section>
</BaseLayout>

<script>
  const btn = document.querySelector('#copy-address');
  const addr = document.querySelector('.mc-address');
  if (btn && addr) {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(addr.textContent ?? '');
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = 'Copy'), 1400);
      } catch {
        btn.textContent = 'Copy failed';
      }
    });
  }
</script>