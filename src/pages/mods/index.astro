---
import BaseLayout from '../../layouts/BaseLayout.astro';
import pack from '../../data/version.json';
import modlist from '../../data/modlist.json';
const base = import.meta.env.BASE_URL;
const systems = [
  { name: 'Automation & industry', items: 'Create, Create: Big Cannons, Applied Energistics 2, Mekanism, Refined Storage.' },
  { name: 'Magic & occult', items: 'Ars Nouveau, Hexerei, Occultism.' },
  { name: 'Combat & firearms', items: 'Timeless & Classics: Zero, SecurityCraft.' },
  { name: 'World', items: 'Biomes O’ Plenty, Tectonic, YUNG’s Better structures, Quark, Serene Seasons.' },
  { name: 'Farming & everyday life', items: 'Farmer’s Delight, Croptopia, Let’s Do, Handcrafted.' },
  { name: 'Comfort, maps & info', items: 'JourneyMap, JEI, AppleSkin, Curios, Sophisticated Backpacks, voice chat.' },
];
---

<BaseLayout
  title="The Modpack"
  description="The curated pack that runs the world — its version, and the full list of mods."
>
  <h1>The Modpack</h1>
  <p lang="en">
    The world runs one curated pack on NeoForge 21.1. Play with the pack
    exactly as it's sent to you — the server checks your game files, and
    anything that isn't official is turned away at the door.
  </p>

  <section class="grid" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); margin: 18px 0">
    <div class="card"><h3 style="margin:0 0 4px">Pack version</h3><strong>{pack.packVersion}</strong><p class="lede">updated {pack.updatedAt}</p></div>
    <div class="card"><h3 style="margin:0 0 4px">Mods</h3><strong>{modlist.count}</strong><p class="lede">in the pack</p></div>
    <div class="card"><h3 style="margin:0 0 4px">Minecraft</h3><strong>{pack.minecraft}</strong><p class="lede">{pack.loader}</p></div>
  </section>

  <section class="grid" style="grid-template-columns: 1fr">
    <div class="card">
      <h3 style="margin-top:0">Headline systems</h3>
      <ul>
        {systems.map((s) => (
          <li><strong>{s.name}</strong> — {s.items}</li>
        ))}
      </ul>
    </div>
  </section>

  <details class="card" style="margin: 18px 0">
    <summary style="cursor:pointer">
      Full mod list ({modlist.count}) — the exact files the pack runs
    </summary>
    <ul class="modlist">
      {modlist.files.map((f) => <li><code>{f}</code></li>)}
    </ul>
    <p class="lede">
      Install the pack exactly as sent. These are the files the server checks
      on join.
    </p>
  </details>

  <p>
    Version history: <a href={`${base}mods/changelog/`}>Changelog</a> ·
    How a mod earns its place: <a href={`${base}mods/development/`}>Development</a>
  </p>
</BaseLayout>